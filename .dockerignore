# Dependencies & build artifacts (rebuilt inside the image)
node_modules
.next
out
*.tsbuildinfo

# Tests — never traced into the standalone output anyway; excluding them keeps
# the build context lean and a test-only change from invalidating the COPY layer.
*.test.ts
vitest.config.ts

# Version control & meta
.git
.gitignore
.github

# Local env & misc
.env*.local
*.log
.DS_Store

# Docker
Dockerfile
.dockerignore

# Infra & docs — not needed to build the app. terraform/ in particular holds
# 100MB+ of provider binaries plus plaintext state/vars; keep it out of the
# build context (smaller/faster builds, no secrets in the builder layer).
terraform/
functions/
docs/
*.md
