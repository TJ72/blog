# Use a flat (npm-style) node_modules instead of pnpm's default symlinked store.
# The symlinked `.pnpm` virtual store is great for local disk usage, but Next's
# `output: standalone` file-tracing doesn't reliably recreate those symlinks for
# `serverExternalPackages` (e.g. @google-cloud/*), so the container would crash
# with MODULE_NOT_FOUND. A hoisted layout makes every dependency a real
# top-level folder, which traces into the standalone build cleanly.
node-linker=hoisted
